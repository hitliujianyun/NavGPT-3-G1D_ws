# Environment for the navgpt-g1d service (systemd EnvironmentFile=). pc2/install.sh writes
# NAVGPT_G1D_PYTHON with the interpreter it found (one that imports unitree_sdk2py, zmq and cv2).
NAVGPT_G1D_ROOT=/opt/navgpt_g1d
NAVGPT_G1D_CONFIG=/opt/navgpt_g1d_site.yaml
NAVGPT_G1D_PYTHON=/usr/bin/python3
CYCLONEDDS_URI=file:///opt/navgpt_g1d/pc2/cyclonedds.xml
PYTHONPATH=/opt/navgpt_g1d:/opt/navgpt_g1d/third_party/unitree_sdk2_python
PYTHONUNBUFFERED=1
